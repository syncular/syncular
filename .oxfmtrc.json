{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/*.d.ts",
    "**/*.generated.ts",
    "**/*.queries.ts",
    "**/*.json",
    "**/*.jsonc",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.css",
    "**/*.html",
    "**/*.toml",
    "**/*.toml.example",
    "**/target",
    ".claude"
  ]
}
