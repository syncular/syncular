              "name": "display_order",
              "declaredType": "integer"
            }
          ],
          "fts": {
            "tokenize": "unicode61",
            "columns": [
              "display_name"
            ]
          },
          "dependencies": [
            {
              "table": "patients",
              "column": "clinic_id",
              "sourceColumn": "clinic_id"
            }
          ]
        }
      ]
    }
  ]
}
