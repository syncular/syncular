---
// Docs search: a trigger button plus a centered teletype dialog. ⌘K / Ctrl+K
// (and `/` outside text fields) opens it from anywhere on the page. The
// section index (/search-index.json) loads on first open. Handlers are
// document-level, so they survive <ClientRouter> swaps without re-binding.
---

<button
  type="button"
  class="search-trigger"
  data-search-open
  aria-haspopup="dialog"
  aria-keyshortcuts="Meta+K Control+K"
>
  <span>search</span><kbd data-search-shortcut>⌘K</kbd>
</button>
<dialog class="search-dialog" data-search-dialog aria-label="Search the docs">
  <div class="search-box">
    <span class="search-prompt" aria-hidden="true">&gt;</span>
    <input
      type="search"
      data-search-input
      placeholder="search the docs"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="true"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <kbd>esc</kbd>
  </div>
  <ol id="search-results" class="search-results" role="listbox" data-search-results>
  </ol>
  <p class="search-status" data-search-status aria-live="polite"></p>
</dialog>

<style is:global>
.search-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
  font: inherit;
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  color: var(--dim);
  background: none;
  border: 1px solid var(--border);
  padding: 0.25rem 0.55rem;
  cursor: pointer;
}
.search-trigger:hover { color: var(--ink); border-color: var(--border-strong); }
.search-trigger::before { content: '/ '; color: var(--amber); }
.search-trigger span { flex: 1; text-align: left; }
.search-trigger kbd,
.search-box kbd { font-size: 0.68rem; color: var(--faint); }
.topnav .search-trigger { padding: 0 0.4rem; font-size: 0.75rem; }

.search-dialog {
  width: min(44rem, calc(100vw - 2rem));
  max-height: min(34rem, calc(100vh - 4rem));
  margin: 8vh auto auto;
  padding: 0;
  background: var(--void);
  color: var(--ink);
  border: 1px solid var(--border-strong);
  box-shadow: 0 0 0 1px #000, 0 0 40px rgba(255, 176, 0, 0.08);
  font-family: inherit;
  font-size: 0.85rem;
}
.search-dialog[open] { display: flex; flex-direction: column; }
.search-dialog::backdrop { background: rgba(0, 0, 0, 0.72); }
.search-box {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.7rem 0.9rem;
  border-bottom: 1px solid var(--border);
}
.search-prompt { color: var(--amber); font-weight: 700; }
.search-box input {
  flex: 1;
  min-width: 0;
  font: inherit;
  font-size: 0.95rem;
  color: var(--ink);
  background: none;
  border: none;
  outline: none;
  caret-color: var(--amber);
}
.search-box input::placeholder { color: var(--faint); }
.search-box input::-webkit-search-cancel-button { display: none; }
.search-results {
  list-style: none;
  margin: 0;
  padding: 0;
  overflow-y: auto;
}
.search-results:empty { display: none; }
.search-results a {
  display: block;
  padding: 0.55rem 0.9rem;
  color: var(--dim);
  text-decoration: none;
  border-left: 2px solid transparent;
}
.search-results a[aria-selected='true'],
.search-results a:hover,
.search-results a:focus-visible {
  background: var(--panel);
  border-left-color: var(--amber);
  outline: none;
}
.search-hit-path { display: block; color: var(--ink); }
.search-hit-path span { color: var(--faint); }
.search-hit-text {
  display: block;
  font-size: 0.75rem;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.search-results mark { background: none; color: var(--amber); }
.search-status {
  margin: 0;
  padding: 0.5rem 0.9rem;
  font-size: 0.7rem;
  color: var(--faint);
}
.search-status:empty { display: none; }
@media (max-width: 860px) {
  .search-trigger kbd { display: none; }
}
</style>

<script>
  import { highlight, searchIndex, type SearchSection } from '../search';

  let index: Promise<SearchSection[]> | undefined;
  let selected = 0;

  const dialog = () =>
    document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = () =>
    document.querySelector<HTMLInputElement>('[data-search-input]');
  const links = () => [
    ...document.querySelectorAll<HTMLAnchorElement>('[data-search-results] a'),
  ];

  const select = (next: number) => {
    const all = links();
    if (all.length === 0) return;
    selected = (next + all.length) % all.length;
    all.forEach((link, i) => {
      link.setAttribute('aria-selected', String(i === selected));
    });
    all[selected]?.scrollIntoView({ block: 'nearest' });
    input()?.setAttribute('aria-activedescendant', all[selected]?.id ?? '');
  };

  const render = async () => {
    const query = input()?.value ?? '';
    const results = document.querySelector('[data-search-results]');
    const status = document.querySelector('[data-search-status]');
    if (results === null || status === null) return;
    index ??= fetch('/search-index.json').then((response) => {
      if (!response.ok) throw new Error(`search index HTTP ${response.status}`);
      return response.json() as Promise<SearchSection[]>;
    });
    let sections: SearchSection[];
    try {
      sections = await index;
    } catch {
      index = undefined;
      results.innerHTML = '';
      status.textContent = 'search index failed to load';
      return;
    }
    if (query !== (input()?.value ?? '')) return;
    const hits = searchIndex(sections, query);
    results.innerHTML = hits
      .map(
        ({ section, excerpt }, i) =>
          `<li role="presentation"><a id="search-hit-${i}" role="option" href="${section.href}">` +
          `<span class="search-hit-path">${highlight(section.page, query)}${
            section.heading === section.page
              ? ''
              : ` <span aria-hidden="true">›</span> ${highlight(section.heading, query)}`
          }</span>` +
          `<span class="search-hit-text">${highlight(excerpt, query)}</span></a></li>`,
      )
      .join('');
    status.textContent =
      query.trim() === ''
        ? 'type to search · ↑↓ to move · enter to open'
        : hits.length === 0
          ? 'no matches'
          : '';
    select(0);
  };

  const open = () => {
    const d = dialog();
    if (d === null || d.open) return;
    d.showModal();
    input()?.select();
    void render();
  };

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target !== null &&
      (target.isContentEditable ||
        ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName));
    if (
      (event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey)) ||
      (event.key === '/' && !typing)
    ) {
      event.preventDefault();
      open();
      return;
    }
    if (!dialog()?.open) return;
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      select(selected + (event.key === 'ArrowDown' ? 1 : -1));
    } else if (event.key === 'Enter' && target === input()) {
      event.preventDefault();
      links()[selected]?.click();
    }
  });

  document.addEventListener('input', (event) => {
    if (event.target === input()) void render();
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (target?.closest('[data-search-open]')) {
      open();
      return;
    }
    const d = dialog();
    if (d?.open !== true) return;
    // A result click navigates; a click on the backdrop (the dialog itself,
    // outside its content box) dismisses.
    if (target?.closest('[data-search-results] a') || target === d) d.close();
  });

  // Each <ClientRouter> swap brings in a fresh trigger. Label it for this
  // platform on first load and after every swap.
  const labelShortcut = () => {
    const shortcut = document.querySelector('[data-search-shortcut]');
    if (shortcut !== null && !/Mac|iPhone|iPad/.test(navigator.userAgent)) {
      shortcut.textContent = 'Ctrl K';
    }
  };
  labelShortcut();
  document.addEventListener('astro:page-load', labelShortcut);
</script>
