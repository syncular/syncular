---
// The landing page: a transmission printout with a live ASCII singularity,
// styled by Tailwind (src/landing.css). Code panels are highlighted by Shiki
// at build time. The script at the bottom runs the hero canvas, the platform
// tabs, the copy buttons, and the interactive sync model; it starts on each
// page view and stops before the client router swaps the page out.
import { Code } from 'astro:components';
import PageMeta from '../components/PageMeta.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Search from '../components/Search.astro';
import { TABS } from '../snippets';
import rootPkg from '../../../../package.json';
import '../landing.css';

// Kept aligned with packages/conformance/src/catalog by
// test/conformance-count.test.ts; the catalog itself is Bun-only
// (import.meta.dir plus the full client/server stacks), so the landing
// page cannot import it during the Astro build.
const CONFORMANCE_SCENARIOS = 242;

const PLATFORM_LINKS = [
  { label: 'WEB', href: '/platform-web/' },
  { label: 'REACT', href: '/platform-react/' },
  { label: 'SWIFT', href: '/platform-swift/' },
  { label: 'KOTLIN', href: '/platform-kotlin/' },
  { label: 'FLUTTER', href: '/platform-flutter/' },
  { label: 'REACT NATIVE', href: '/platform-react-native/' },
  { label: 'TAURI', href: '/platform-tauri/' },
  { label: 'RUST', href: '/platform-rust/' },
  { label: 'C FFI', href: '/platform-ffi/' },
] as const;

const CAPS = [
  ['Recovery that survives a restart', 'Rejected commits and losing writes stay on disk as structured records until your app resolves them.', '/concepts-conflicts/'],
  ['Realtime over one socket', 'A connected client runs its whole sync loop over one WebSocket and receives verified deltas.', '/concepts-realtime/'],
  ['Partial replicas', 'Windowed sync evicts rows atomically, and a completeness check tells a query whether its local data is whole.', '/concepts-windowing/'],
  ['Full-text search offline', 'Generated FTS5 projections follow the local SQLite data, so search runs without a network.', '/tooling-local-search/'],
  ['Collaborative text', 'CRDT columns merge concurrent text edits per column, byte-identical across both cores.', '/concepts-crdt/'],
  ['Attachments', 'Content-addressed blobs on S3 or R2. The server re-authorizes every download.', '/concepts-blobs/'],
  ['Column encryption', 'Optional end-to-end encryption per column with AES-256-GCM keyrings and local revocation.', '/concepts-encryption/'],
  ['Testkit', 'An in-process server, fault injection, and a virtual clock drive the real engine in your tests.', '/tooling-testing/'],
] as const;

// The resolver is transcribed from concepts-scopes.md.
const SERVER_CODE = `const config: SyncServerConfig = {
  schema,
  storage,
  segments,
  // Every scope value this actor holds, across all tables.
  resolveScopes: async ({ actorId }) => {
    const lists = await db.listsForUser(actorId); // your query
    return { list_id: lists.map((l) => l.id) };
  },
};`;

const SQL_CODE = `-- queries/list-todos.sql
select id, list_id, title, done
from todos
where list_id = :listId
order by position, id;`;

const title = 'syncular: SQLite on every device, one log on your server';
const description =
  'Syncular gives web and native apps a local SQLite database and keeps every client in sync through one ordered commit log on your server. Apache-2.0.';
---

<!doctype html>
<html lang="en" class="bg-void">
  <head>
    <PageMeta
      title={title}
      description={description}
      canonicalPath="/"
      documentTitle={title}
    />
    <link rel="alternate" type="text/markdown" href="/index.md" />
  </head>
  <body class="overflow-x-hidden bg-void font-mono text-ink antialiased">
<!-- Navigation -->
<header class="sticky top-0 z-40 border-b border-line bg-void/75 backdrop-blur-md">
  <div class="mx-auto max-w-page px-5 sm:px-8 h-16 flex items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-3 font-semibold tracking-[0.22em] text-[15px]">
        <img src="/favicon.svg" width="24" height="24" alt="" class="shrink-0" />
        SYNCULAR<span class="text-amber blink">_</span>
      </a>
      <a href={`https://github.com/syncular/syncular/releases/tag/v${rootPkg.version}`} class="hidden border border-line px-1.5 py-0.5 text-[10.5px] tracking-[0.12em] text-faint hover:border-line-strong hover:text-ink transition-colors sm:inline-flex">v{rootPkg.version}</a>
    </div>
    <nav class="flex items-center gap-0 sm:gap-1 text-[12px] sm:text-[12.5px] tracking-[0.12em]">
      <a href="/docs/" class="hidden md:block px-3 py-2 text-dim hover:text-ink transition-colors">DOCS</a>
      <a href="/blog/" class="hidden md:block px-3 py-2 text-dim hover:text-ink transition-colors">BLOG</a>
      <a href="/benchmarks/" class="hidden md:block px-3 py-2 text-dim hover:text-ink transition-colors">BENCHMARKS</a>
      <a href="/changelog/" class="hidden md:block px-3 py-2 text-dim hover:text-ink transition-colors">CHANGELOG</a>
      <a href="https://github.com/syncular/syncular" class="hidden md:block px-3 py-2 text-dim hover:text-ink transition-colors">GITHUB</a>
      <div class="nav-search hidden lg:contents"><Search /></div>
      <MobileMenu />
      <a href="/quickstart/" class="ml-2 h-9 px-3 sm:px-4 flex items-center bg-amber text-void font-semibold hover:bg-[#ffc233] transition-colors">QUICKSTART</a>
    </nav>
  </div>
</header>

<main>

<!-- ============================== HERO: what is this ============================== -->
<section class="relative isolate overflow-hidden">
  <div class="grid-bg absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto max-w-page px-5 sm:px-8 pt-14 pb-16 lg:pt-24 lg:pb-24 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
    <div class="lg:col-span-6">
      <p class="inline-flex items-center gap-3 border border-line px-3 py-1.5 text-[11px] tracking-[0.16em] text-dim">
        <span class="h-1.5 w-1.5 bg-phos shadow-[0_0_8px_#a9bf6e]"></span>
        OPEN-SOURCE SYNC ENGINE · APACHE-2.0
      </p>
      <h1 class="mt-7 text-[2.3rem] leading-[1.08] sm:text-[3.3rem] lg:text-[3.6rem] font-semibold tracking-[-0.035em]">
        SQLite on every device<span class="text-amber">.</span><br />
        <span class="text-amber">One log on your server.</span>
      </h1>
      <p class="mt-7 max-w-xl lead text-[1.075rem] leading-[1.7]">
        Syncular gives web and native apps a local SQLite database. Reads and
        writes run against it without a network round trip, online or off.
        Your server orders every write into one commit log, checks it against
        your access rules, and sends each client the rows it may see.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/quickstart/" class="group h-12 px-6 inline-flex items-center gap-3 bg-amber text-void font-semibold text-[13px] tracking-[0.12em] hover:bg-[#ffc233] transition-colors">
          START THE QUICKSTART <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a href="/demo/" data-astro-reload class="h-12 px-6 inline-flex items-center gap-3 border border-line-strong text-[13px] tracking-[0.12em] hover:border-ink transition-colors">
          OPEN THE LIVE DEMO <span class="text-faint">→</span>
        </a>
      </div>
      <button type="button" data-copy="bun create syncular-app my-app" class="copy mt-6 group w-full sm:w-auto inline-flex items-center justify-between gap-6 border border-line bg-panel/80 pl-4 pr-3 h-11 text-[13.5px] hover:border-line-strong transition-colors">
        <span><span class="text-amber">$</span> bun create syncular-app my-app</span>
        <span class="copy-label text-[11px] tracking-[0.14em] text-faint group-hover:text-dim">COPY</span>
      </button>
    </div>

    <figure class="lg:col-span-6 relative">
      <div class="halo absolute -inset-10 -z-10" aria-hidden="true"></div>
      <div class="ticks border border-line bg-void/60">
        <span class="tk-b" aria-hidden="true"></span>
        <div class="flex items-center justify-between border-b border-line px-4 h-9 text-[10.5px] tracking-[0.16em] text-faint">
          <span>FIG. 1 · COMMIT LOG</span>
          <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 bg-amber blink"></span>LIVE SIMULATION</span>
        </div>
        <canvas id="hole" class="block aspect-[99/80] w-full" role="img" aria-label="Animated ASCII rendering of a black hole accretion disk; labeled commits spiral into the event horizon"></canvas>
        <div class="flex items-center justify-between border-t border-line px-4 h-9 text-[10.5px] tracking-[0.14em] text-faint">
          <span id="sim-status">INFALL 0 WRITES · NEXT c41</span>
          <button id="sim-toggle" type="button" class="text-amber hover:text-ink">[ PAUSE ]</button>
        </div>
      </div>
      <figcaption class="mt-4 text-[11.5px] leading-relaxed tracking-[0.06em] text-faint">
        Each client owns a database. The server owns the order.
        <a href="#follow" class="text-dim underline decoration-line-strong underline-offset-4 hover:text-amber hover:decoration-amber">Run the model below ↓</a>
      </figcaption>
    </figure>
  </div>
</section>

<!-- Platforms -->
<div class="border-y border-line bg-panel/60">
  <div class="mx-auto max-w-page px-5 sm:px-8 py-5 flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
    <span class="label shrink-0">ONE PROTOCOL ON</span>
    <div class="flex flex-1 flex-wrap md:justify-between gap-x-5 gap-y-2 text-[12px] tracking-[0.12em] text-dim">
      {PLATFORM_LINKS.map((p) => <a href={p.href} class="hover:text-amber">{p.label}</a>)}
    </div>
  </div>
</div>

<!-- ============================== §01 WHY ============================== -->
<section class="mx-auto max-w-page px-5 sm:px-8 py-24 lg:py-32">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
    <div class="lg:col-span-7">
      <p class="kicker">§01 · WHY</p>
      <h2 class="h2">What the sync layer<br />does for you<span class="text-amber">.</span></h2>
    </div>
    <p class="lg:col-span-5 lead">
      Syncular implements five parts of offline sync as protocol behavior: a
      durable outbox, conflict reporting, scope-based authorization, segment
      bootstrap for new devices, and schema upgrades for old clients. You
      write a SQL schema and one function.
    </p>
  </div>

  <div class="mt-14 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10">
    <ol class="lg:col-span-6 border-t border-line">
      <li class="grid grid-cols-[2.5rem_1fr] sm:grid-cols-[2.5rem_9.5rem_1fr] gap-x-4 gap-y-1 py-5 border-b border-line">
        <span class="text-[11px] text-amber pt-0.5">01</span>
        <span class="text-[14px] font-semibold">Retry queue</span>
        <span class="col-start-2 sm:col-start-auto font-sans text-[14px] leading-[1.7] text-dim">A durable <a href="/concepts-subscriptions/" class="ul">outbox</a> that survives restarts and replays in order on reconnect.</span>
      </li>
      <li class="grid grid-cols-[2.5rem_1fr] sm:grid-cols-[2.5rem_9.5rem_1fr] gap-x-4 gap-y-1 py-5 border-b border-line">
        <span class="text-[11px] text-amber pt-0.5">02</span>
        <span class="text-[14px] font-semibold">Conflicts</span>
        <span class="col-start-2 sm:col-start-auto font-sans text-[14px] leading-[1.7] text-dim">A version mismatch reaches <a href="/concepts-conflicts/" class="ul">your app</a> with the server row attached, and stays recorded until you resolve it.</span>
      </li>
      <li class="grid grid-cols-[2.5rem_1fr] sm:grid-cols-[2.5rem_9.5rem_1fr] gap-x-4 gap-y-1 py-5 border-b border-line">
        <span class="text-[11px] text-amber pt-0.5">03</span>
        <span class="text-[14px] font-semibold">Authorization</span>
        <span class="col-start-2 sm:col-start-auto font-sans text-[14px] leading-[1.7] text-dim">The server checks every commit and every subscription against the <a href="/concepts-scopes/" class="ul">scopes</a> your resolver returns.</span>
      </li>
      <li class="grid grid-cols-[2.5rem_1fr] sm:grid-cols-[2.5rem_9.5rem_1fr] gap-x-4 gap-y-1 py-5 border-b border-line">
        <span class="text-[11px] text-amber pt-0.5">04</span>
        <span class="text-[14px] font-semibold">Bootstrap</span>
        <span class="col-start-2 sm:col-start-auto font-sans text-[14px] leading-[1.7] text-dim">A new device downloads its rows as bootstrap <a href="/concepts-bootstrap/" class="ul">segments</a>: 100,000 rows in 379.9 ms. <span class="text-faint">Prebuilt SQLite image: 46.5 ms.</span></span>
      </li>
      <li class="grid grid-cols-[2.5rem_1fr] sm:grid-cols-[2.5rem_9.5rem_1fr] gap-x-4 gap-y-1 py-5 border-b border-line">
        <span class="text-[11px] text-amber pt-0.5">05</span>
        <span class="text-[14px] font-semibold">Upgrades</span>
        <span class="col-start-2 sm:col-start-auto font-sans text-[14px] leading-[1.7] text-dim">On a <a href="/concepts-schema-upgrades/" class="ul">schema change</a> a client keeps its outbox, re-bootstraps at the new version, and replays.</span>
      </li>
    </ol>

    <div class="lg:col-span-6">
      <div class="ticks border border-line bg-panel shadow-[0_30px_80px_-40px_rgba(255,176,0,0.25)]">
        <span class="tk-b" aria-hidden="true"></span>
        <div class="flex items-center justify-between border-b border-line px-4 h-10 text-[11px] tracking-[0.12em] text-faint">
          <span><span class="text-dim">server/</span>sync.ts</span>
          <span class="text-amber">THE FUNCTION YOU WRITE</span>
        </div>
        <div class="[&_pre]:overflow-x-auto [&_pre]:p-5 sm:[&_pre]:p-6 [&_pre]:text-[12px] sm:[&_pre]:text-[13px] [&_pre]:leading-[1.8]">
          <Code code={SERVER_CODE} lang="ts" theme="css-variables" />
        </div>
      </div>
      <p class="mt-5 font-sans text-[14px] leading-[1.7] text-dim">
        The server calls <code class="font-mono text-[12.5px] text-ink">resolveScopes</code>
        at most once per request, next to your existing auth. If it throws,
        the request syncs no rows.
      </p>
    </div>
  </div>
</section>

<!-- ============================== §02 HOW IT WORKS ============================== -->
<section id="follow" class="border-t border-line">
  <div class="mx-auto max-w-page px-5 sm:px-8 py-24 lg:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-7">
        <p class="kicker">§02 · HOW IT WORKS</p>
        <h2 class="h2">Follow one write<span class="text-amber">.</span></h2>
      </div>
      <p class="lg:col-span-5 lead">
        Three devices share one server below. Write on any of them, take the
        iPhone offline, and watch the commit log decide who receives what.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-3 border-l border-t border-line">
      <div class="p-6 sm:p-7 border-r border-b border-line">
        <p class="label">01 · ON THE DEVICE</p>
        <h3 class="mt-4 text-[17px] font-semibold tracking-tight">The write is local first<span class="text-amber">.</span></h3>
        <p class="mt-3 font-sans text-[14px] leading-[1.7] text-dim">One local transaction updates the table and appends the commit to the outbox. Queries see the new row immediately.</p>
      </div>
      <div class="p-6 sm:p-7 border-r border-b border-line">
        <p class="label">02 · ON YOUR SERVER</p>
        <h3 class="mt-4 text-[17px] font-semibold tracking-tight">The server orders it<span class="text-amber">.</span></h3>
        <p class="mt-3 font-sans text-[14px] leading-[1.7] text-dim">The outbox pushes an idempotent commit. The server checks it against the actor's scopes and appends all of it to the log, or none of it.</p>
      </div>
      <div class="p-6 sm:p-7 border-r border-b border-line">
        <p class="label">03 · ON EVERY OTHER DEVICE</p>
        <h3 class="mt-4 text-[17px] font-semibold tracking-tight">Subscribers receive it<span class="text-amber">.</span></h3>
        <p class="mt-3 font-sans text-[14px] leading-[1.7] text-dim">Connected clients with a matching scope get the delta over one WebSocket. A device that was offline pulls what it missed on reconnect.</p>
      </div>
    </div>

    <div id="sim" class="mt-14">
      <div class="ticks border border-line bg-panel">
        <span class="tk-b" aria-hidden="true"></span>
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-4 py-2.5 text-[11px] tracking-[0.14em]">
          <span class="text-ink">YOUR SERVER · COMMIT LOG <span class="text-faint">· ORDERED · SCOPED</span></span>
          <span class="flex items-center gap-4 text-faint">
            <span id="sim-mode">AUTOPLAY</span>
            <button type="button" id="sim-reset" class="text-amber hover:text-ink">[ RESET ]</button>
          </span>
        </div>
        <div class="hidden sm:grid grid-cols-[4.5rem_6rem_1fr_9rem_1fr] gap-3 px-4 pt-3 pb-1 text-[10px] tracking-[0.16em] text-faint">
          <span>SEQ</span><span>FROM</span><span>CHANGE</span><span>SCOPE</span><span>DELIVERED TO</span>
        </div>
        <ol id="log" class="px-2 pb-2 h-[13rem] sm:h-[13.5rem] overflow-hidden flex flex-col justify-end text-[12.5px]"></ol>
      </div>
      <div id="devices" class="grid grid-cols-1 md:grid-cols-3 gap-x-5"></div>
      <p class="mt-6 text-[11.5px] leading-relaxed tracking-[0.06em] text-faint">
        <span class="text-dim">Interactive model.</span> It runs in this page without a network.
        The Pixel subscribes to <span class="text-dim">list_id = work</span>, so commits scoped to groceries never reach it.
      </p>
    </div>

    <p class="mt-14 border-t border-line pt-6 text-[12px] tracking-[0.08em] text-faint leading-loose">
      THE MECHANICS:
      <a href="/concepts-commits/" class="text-dim hover:text-amber">commits, cursors &amp; idempotency</a> ·
      <a href="/concepts-realtime/" class="text-dim hover:text-amber">realtime</a> ·
      <a href="/concepts-conflicts/" class="text-dim hover:text-amber">conflicts</a>
    </p>
  </div>
</section>

<!-- ============================== §03 DIFFERENCE ============================== -->
<section class="border-t border-line relative isolate overflow-hidden">
  <div class="halo absolute left-1/2 top-1/2 -z-10 h-[50rem] w-[70rem] -translate-x-1/2 -translate-y-1/2 opacity-70" aria-hidden="true"></div>
  <div class="mx-auto max-w-page px-5 sm:px-8 py-20 lg:py-28">
    <div class="ticks border border-amber/70 bg-[rgba(255,176,0,0.035)] shadow-[0_0_120px_-40px_rgba(255,176,0,0.35)]">
      <span class="tk-b" aria-hidden="true"></span>
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 bg-amber text-void px-5 py-2.5 text-[11px] font-semibold tracking-[0.18em]">
        <span>§03 · WHAT SETS SYNCULAR APART</span>
        <span class="font-medium opacity-70">QUERIES · SCHEMA · PERMISSIONS · SPEED</span>
      </div>
      <div class="px-5 sm:px-8 pt-8 sm:pt-10 pb-2">
        <h2 class="text-[1.9rem] sm:text-[2.5rem] leading-[1.1] font-semibold tracking-[-0.03em]">What sets Syncular apart<span class="text-amber">.</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 mt-6 border-t border-amber/30">
        <article class="flex flex-col p-6 sm:p-7 border-amber/30 border-b lg:border-b-0 md:border-r lg:border-r ">
          <p class="text-[2.2rem] leading-none font-semibold text-amber tracking-tight">01</p>
          <h3 class="mt-5 text-[18px] font-semibold tracking-tight leading-snug">Real SQL, with types.</h3>
          <p class="mt-3 font-sans text-[14px] leading-[1.7] text-dim">Your app reads from a real SQLite database on the device. Write a query in SQL and the generator gives you a typed function for TypeScript, Swift, Kotlin, Dart, or Rust.</p>
          <a href="/tooling-queries/" class="mt-auto pt-6 text-[11px] tracking-[0.14em] text-amber hover:text-ink">TYPED QUERIES →</a>
        </article>
        <article class="flex flex-col p-6 sm:p-7 border-amber/30 border-b lg:border-b-0 lg:border-r ">
          <p class="text-[2.2rem] leading-none font-semibold text-amber tracking-tight">02</p>
          <h3 class="mt-5 text-[18px] font-semibold tracking-tight leading-snug">Your schema stays your schema.</h3>
          <p class="mt-3 font-sans text-[14px] leading-[1.7] text-dim">Tables are normal SQL tables with foreign keys and indexes. Syncular adds one requirement: each synced row carries a column such as <code class="font-mono text-[12.5px] text-ink">list_id</code> that says which group it belongs to.</p>
          <a href="/guide-schema/" class="mt-auto pt-6 text-[11px] tracking-[0.14em] text-amber hover:text-ink">SCHEMA →</a>
        </article>
        <article class="flex flex-col p-6 sm:p-7 border-amber/30 border-b lg:border-b-0 md:border-r lg:border-r ">
          <p class="text-[2.2rem] leading-none font-semibold text-amber tracking-tight">03</p>
          <h3 class="mt-5 text-[18px] font-semibold tracking-tight leading-snug">Permissions are a function.</h3>
          <p class="mt-3 font-sans text-[14px] leading-[1.7] text-dim">You write one function that returns what each user may see, using your own tables. The server enforces it on every write and every subscription, so a device never receives a row outside it.</p>
          <a href="/concepts-scopes/" class="mt-auto pt-6 text-[11px] tracking-[0.14em] text-amber hover:text-ink">SCOPES →</a>
        </article>
        <article class="flex flex-col p-6 sm:p-7 border-amber/30 border-b lg:border-b-0 lg:border-r-0 ">
          <p class="text-[2.2rem] leading-none font-semibold text-amber tracking-tight">04</p>
          <h3 class="mt-5 text-[18px] font-semibold tracking-tight leading-snug">Fast, because nothing waits.</h3>
          <p class="mt-3 font-sans text-[14px] leading-[1.7] text-dim">Reads are local queries and writes commit locally first. A new device downloads snapshots instead of replaying history, and a connected device receives only its own changes.</p>
          <a href="/concepts-bootstrap/" class="mt-auto pt-6 text-[11px] tracking-[0.14em] text-amber hover:text-ink">BOOTSTRAP →</a>
        </article>
      </div>
    </div>
  </div>
</section>

<!-- ============================== §04 YOUR PLATFORM ============================== -->
<section class="border-t border-line bg-panel/40">
  <div class="mx-auto max-w-page px-5 sm:px-8 py-24 lg:py-32 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10">
    <div class="lg:col-span-4">
      <p class="kicker">§04 · YOUR PLATFORM</p>
      <h2 class="h2">Create, subscribe,<br />write, sync<span class="text-amber">.</span></h2>
      <p class="mt-6 lead">
        The calls are the same on every platform. Web apps run the TypeScript
        core in a Web Worker on OPFS-backed sqlite-wasm. Every other platform
        runs the Rust core through a five-function C FFI.
      </p>
      <p class="mt-4 lead">
        Both cores implement one written protocol, so a Swift client and a
        browser tab sync against the same server.
      </p>

      <div class="mt-10 pt-6 border-t border-line">
        <p class="label">TYPED READS</p>
