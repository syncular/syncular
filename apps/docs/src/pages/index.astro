    <script>
      import { pageScript } from '../page-lifecycle';

      pageScript(() => {
        // The other pages have no hero canvas.
        if (!document.getElementById('hole')) return;
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Everything a page view starts that outlives its DOM: frames, timers,
        // observers, and window listeners. The teardown below cancels them.
        let alive = true;
        const timeouts = new Set();
        const cleanups = [];

        /* ---------------- Copy buttons ---------------- */
        for (const btn of document.querySelectorAll('.copy')) {
          btn.addEventListener('click', async () => {
            const label = btn.querySelector('.copy-label');
            try {
              await navigator.clipboard.writeText(btn.dataset.copy);
              label.textContent = 'COPIED';
              label.classList.add('text-phos');
            } catch {
              label.textContent = 'SELECT TO COPY';
            }
            const id = setTimeout(() => { timeouts.delete(id); label.textContent = 'COPY'; label.classList.remove('text-phos'); }, 1400);
            timeouts.add(id);
          });
        }

        /* ---------------- Hero: ASCII singularity on canvas ----------------
           The accretion disk, photon ring, and infalling labeled commits, drawn per
           glyph so brightness maps onto an amber-to-ink ramp. */
        (() => {
          const W = 90, H = 40, CX = W / 2, CY = H / 2, ASPECT = 0.55;
          const RAMP = ' .,:;+*#@';
          const canvas = document.getElementById('hole');
          const ctx = canvas.getContext('2d');
          const status = document.getElementById('sim-status');
          const toggle = document.getElementById('sim-toggle');
          const hash = (x, y) => { const s = Math.sin(x * 127.1 + y * 311.7) * 43758.5453; return s - Math.floor(s); };
          let cw = 0, ch = 0;

          const resize = () => {
            const dpr = Math.min(devicePixelRatio || 1, 2);
            const w = canvas.clientWidth;
            cw = w / W; ch = cw / ASPECT;
            canvas.width = Math.round(w * dpr);
            canvas.height = Math.round(ch * H * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.font = `500 ${(cw / 0.6).toFixed(2)}px "IBM Plex Mono", monospace`;
            ctx.textBaseline = 'middle';
            ctx.textAlign = 'center';
          };

          // Disk glyphs warm from dim ink at the rim to amber at the photon ring.
          const mix = (t, a) => {
            const r = Math.round(154 + (255 - 154) * t), g = Math.round(148 + (176 - 148) * t), b = Math.round(138 * (1 - t));
            return `rgba(${r},${g},${b},${a.toFixed(2)})`;
          };

          let seq = 41, commits = [], nextSpawn = 0;
          const spawn = (t) => commits.push({ label: 'c' + seq++, a: Math.random() * Math.PI * 2, r: 24 + Math.random() * 8, born: t, speed: 2.4 + Math.random() * 1.6 });

          function frame(t) {
            const w = cw * W, h = ch * H;
            ctx.clearRect(0, 0, w, h);
            const g = ctx.createRadialGradient(w / 2, h / 2, ch * 3, w / 2, h / 2, ch * 14);
            g.addColorStop(0, 'rgba(255,176,0,0.20)');
            g.addColorStop(0.4, 'rgba(255,176,0,0.05)');
            g.addColorStop(1, 'rgba(255,176,0,0)');
            ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);

            const buckets = new Map();
            const put = (style, chr, x, y) => { let b = buckets.get(style); if (!b) buckets.set(style, b = []); b.push(chr, x, y); };

            for (let y = 0; y < H; y++) {
              for (let x = 0; x < W; x++) {
                const dx = (x - CX) * ASPECT, dy = y - CY;
                const r = Math.hypot(dx, dy), a = Math.atan2(dy, dx);
                if (r < 5.0) continue;
                if (r < 6.6) {
                  const p = 0.5 + 0.5 * Math.sin(a * 3 - t * 3.6 + r);
                  put('#ffb000', p > 0.66 ? '@' : p > 0.33 ? '#' : '*', x, y);
                } else if (r < 19) {
                  const band = (r - 6.6) / 12.4;
                  let b = (0.5 + 0.5 * Math.sin(2 * a - r * 1.35 + t * 2.4)) * (1 - band * 0.85);
                  b += 0.3 * Math.cos(a - t * 0.9) * (1 - band);
                  b += (hash(x, y) - 0.5) * 0.18;
                  const k = Math.max(0, Math.min(8, Math.floor(b * 9)));
                  if (k === 0) continue;
                  const warm = Math.max(0, 1 - band * 1.6);
                  put(mix(Math.round(warm * 4) / 4, 0.35 + Math.round(k / 2) * 0.14), RAMP[k], x, y);
                } else {
                  const hh = hash(x * 3.1, y * 7.7);
                  if (hh > 0.972 && Math.sin(t * 1.7 + hh * 90) > -0.3) put('rgba(154,148,138,0.55)', hh > 0.994 ? '+' : '.', x, y);
                }
              }
            }
            for (const c of commits) {
              const age = t - c.born;
              c.rNow = c.r - c.speed * age * (1 + 0.06 * age);
              c.aNow = c.a + 1.7 * Math.log(c.r / Math.max(c.rNow, 1));
              for (let k = 6; k >= 0; k--) {
                const rr = c.rNow + k * 0.8, aa = c.aNow - k * 0.1;
                if (rr < 5 || rr > 34) continue;
                const px = Math.round(CX + (rr * Math.cos(aa)) / ASPECT), py = Math.round(CY + rr * Math.sin(aa));
                if (px < 0 || px >= W || py < 0 || py >= H) continue;
                if (k === 0) {
                  put('#ffffff', '@', px, py);
                  for (let l = 0; l < c.label.length; l++) if (px + 2 + l < W) put('#ffb000', c.label[l], px + 2 + l, py);
                } else {
                  put(`rgba(255,176,0,${(0.9 - k * 0.12).toFixed(2)})`, k < 3 ? '*' : k < 5 ? ':' : '.', px, py);
                }
              }
            }
            commits = commits.filter((c) => c.rNow > 5.2);
            if (t > nextSpawn) { spawn(t); nextSpawn = t + 1.1 + Math.random() * 1.6; }

            for (const [style, list] of buckets) {
              ctx.fillStyle = style;
              for (let i = 0; i < list.length; i += 3) ctx.fillText(list[i], (list[i + 1] + 0.5) * cw, (list[i + 2] + 0.5) * ch);
            }
            status.textContent = `INFALL ${commits.length} WRITE${commits.length === 1 ? '' : 'S'} · NEXT c${seq}`;
          }

          let running = !reducedMotion, tick = 0;
          toggle.textContent = running ? '[ PAUSE ]' : '[ RUN ]';
          toggle.addEventListener('click', () => { running = !running; toggle.textContent = running ? '[ PAUSE ]' : '[ RUN ]'; });
          resize();
          const onResize = () => { resize(); frame(performance.now() / 1000); };
          addEventListener('resize', onResize);
          document.fonts?.ready.then(() => { if (alive) onResize(); });
          frame(0);
          let raf = 0;
          const loop = (now) => { if (running && tick++ % 2 === 0) frame(now / 1000); raf = requestAnimationFrame(loop); };
          raf = requestAnimationFrame(loop);
          cleanups.push(() => { cancelAnimationFrame(raf); removeEventListener('resize', onResize); });
        })();

        /* ---------------- Platform tabs ---------------- */
        (() => {
          const tabs = document.querySelectorAll('[role="tab"]');
          const core = document.getElementById('tab-core');
          for (const tab of tabs) {
            tab.addEventListener('click', () => {
              for (const other of tabs) {
                const on = other === tab;
                other.setAttribute('aria-selected', String(on));
                document.getElementById(other.getAttribute('aria-controls')).hidden = !on;
              }
              core.textContent = tab.dataset.core;
            });
          }
        })();

        /* ---------------- Sync model ----------------
           Three devices, one commit log. Writes apply locally and enter the outbox;
           online devices push, the log assigns a sequence and delivers to devices
           whose subscription scope matches. Offline devices hold their outbox and
           pull missed commits on reconnect. */
        (() => {
          const POOL = {
            groceries: ['coffee beans', 'olive oil', 'eggs', 'parmesan', 'rice', 'tomatoes', 'oat milk', 'rye bread', 'lemons', 'basil'],
            work: ['cut release', 'update SPEC §3.3', 'rotate keys', 'bench run', 'review PR 107', 'triage issues'],
          };
          const DEVICES = [
            { id: 'web', name: 'Browser tab', core: 'TS core · OPFS', scope: 'groceries' },
            { id: 'ios', name: 'iPhone', core: 'Rust core · Swift', scope: 'groceries' },
            { id: 'android', name: 'Pixel', core: 'Rust core · Kotlin', scope: 'work' },
          ];
          const MAX_ROWS = 4;
          const narrow = matchMedia('(max-width: 639px)');
          const wait = (ms) => new Promise((r) => {
            const id = setTimeout(() => { timeouts.delete(id); r(); }, reducedMotion ? 0 : ms);
            timeouts.add(id);
          });
          const root = document.getElementById('devices');
          const logEl = document.getElementById('log');
          const modeEl = document.getElementById('sim-mode');
          const name = (id) => DEVICES.find((d) => d.id === id).name;
          let state, chain, poolIdx, auto = true, autoTimer;

          function reset() {
            poolIdx = { groceries: 0, work: 0 };
            chain = Promise.resolve();
            const seed = [
              { seq: 42, from: 'ios', scope: 'groceries', title: 'lemons' },
              { seq: 43, from: 'android', scope: 'work', title: 'triage issues' },
              { seq: 44, from: 'web', scope: 'groceries', title: 'basil' },
              { seq: 45, from: 'web', scope: 'groceries', title: 'oat milk' },
              { seq: 46, from: 'android', scope: 'work', title: 'review PR 107' },
              { seq: 47, from: 'ios', scope: 'groceries', title: 'rye bread' },
            ];
            state = { seq: 47, log: seed.map((c) => ({ ...c, delivered: DEVICES.filter((d) => d.id !== c.from && d.scope === c.scope).map((d) => d.id) })) };
            for (const d of DEVICES) {
              d.online = true; d.outbox = []; d.cursor = 47;
              d.rows = seed.filter((c) => c.scope === d.scope).reverse().map((c) => ({ title: c.title, seq: c.seq }));
            }
            renderDevices(); renderLog();
          }

          function renderDevices() {
            root.innerHTML = '';
            for (const d of DEVICES) {
              const col = document.createElement('div');
              col.innerHTML = `
                <div class="wire h-12" aria-hidden="true"><span class="pkt"></span></div>
                <article class="dev border bg-panel transition-colors">
                  <header class="flex items-center justify-between gap-3 border-b border-line px-4 h-12">
                    <div class="min-w-0">
                      <p class="text-[13px] font-semibold truncate">${d.name}</p>
                      <p class="text-[10.5px] tracking-[0.08em] text-faint truncate">${d.core}</p>
                    </div>
                    <button type="button" class="net shrink-0 inline-flex items-center gap-2 h-7 px-2.5 border text-[10.5px] tracking-[0.14em]"></button>
                  </header>
                  <div class="px-4 pt-3 pb-1 flex justify-between text-[10px] tracking-[0.16em] text-faint"><span>todos <span class="text-dim">WHERE list_id = ${d.scope}</span></span><span>STATE</span></div>
                  <ul class="rows px-2 h-[8.6rem] text-[12.5px]"></ul>
                  <footer class="flex items-center justify-between gap-3 border-t border-line px-4 h-12">
                    <span class="ob text-[11px] tracking-[0.12em]"></span>
                    <button type="button" class="write h-8 px-3 border border-amber/60 text-amber text-[11px] tracking-[0.14em] hover:bg-amber hover:text-void transition-colors">+ WRITE</button>
                  </footer>
                </article>`;
              d.el = col;
              col.querySelector('.write').addEventListener('click', () => { stopAuto(); write(d); });
              col.querySelector('.net').addEventListener('click', () => { stopAuto(); setOnline(d, !d.online); });
              root.append(col);
              renderDevice(d);
            }
          }

          function renderDevice(d, fresh) {
            const net = d.el.querySelector('.net');
            net.className = 'net shrink-0 inline-flex items-center gap-2 h-7 px-2.5 border text-[10.5px] tracking-[0.14em] transition-colors ' +
              (d.online ? 'border-phos/50 text-phos hover:border-phos' : 'border-line-strong text-faint hover:text-dim');
            net.innerHTML = `<span class="h-1.5 w-1.5 ${d.online ? 'bg-phos shadow-[0_0_8px_#a9bf6e]' : 'bg-faint'}"></span>${d.online ? 'ONLINE' : 'OFFLINE'}`;
            net.setAttribute('aria-label', d.online ? `Take ${d.name} offline` : `Bring ${d.name} online`);
            const card = d.el.querySelector('.dev');
            card.classList.toggle('border-line', d.online);
            card.classList.toggle('border-dashed', !d.online);
            card.classList.toggle('border-line-strong', !d.online);
            d.el.querySelector('.rows').innerHTML = d.rows.slice(0, MAX_ROWS).map((r) => `
              <li class="${fresh === r ? 'row-in ' : ''}flex items-center justify-between gap-3 px-2 h-[2.1rem] border-b border-line/60 last:border-0">
                <span class="truncate ${r.seq ? '' : 'text-amber'}">${r.title}</span>
                <span class="shrink-0 text-[11px] ${r.seq ? 'text-faint' : 'text-amber'}">${r.seq ? 'c' + r.seq : '● outbox'}</span>
              </li>`).join('');
            const n = d.outbox.length;
            d.el.querySelector('.ob').innerHTML = n
              ? `<span class="text-amber">OUTBOX ${n}</span> <span class="text-faint">· ${d.online ? 'pushing' : 'held offline'}</span>`
              : '<span class="text-faint">OUTBOX 0 · in sync</span>';
          }

          function renderLog(freshSeq) {
            logEl.innerHTML = state.log.slice(narrow.matches ? -4 : -6).map((c) => {
              const others = DEVICES.some((o) => o.id !== c.from && o.scope === c.scope);
              const to = c.delivered.length ? '→ ' + c.delivered.map(name).join(', ') : others ? 'held for offline subscriber' : 'no other subscriber';
              return `
              <li class="${c.seq === freshSeq ? 'log-in ' : ''}grid grid-cols-[3.5rem_1fr] sm:grid-cols-[4.5rem_6rem_1fr_9rem_1fr] gap-x-3 px-2 py-1.5 border-b border-line/50 last:border-0">
                <span class="text-amber">c${c.seq}</span>
                <span class="hidden sm:block text-dim truncate">${name(c.from)}</span>
                <span class="truncate">upsert todos <span class="text-dim">"${c.title}"</span></span>
                <span class="hidden sm:block text-faint">${c.scope}</span>
                <span class="col-start-2 sm:col-start-auto text-[11.5px] truncate ${c.delivered.length ? 'text-phos' : 'text-faint'}">${to}</span>
              </li>`;
            }).join('');
          }

          function pulse(d, dir) {
            const p = d.el.querySelector('.pkt');
            p.classList.remove('up', 'down');
            void p.offsetWidth;
            p.classList.add(dir);
          }

          const enqueue = (fn) => (chain = chain.then(fn));

          function deliver(o, c) {
            const row = { title: c.title, seq: c.seq };
            o.rows.unshift(row); o.cursor = c.seq;
            if (!c.delivered.includes(o.id)) c.delivered.push(o.id);
            renderDevice(o, row);
          }

          async function push(d) {
            while (d.online && d.outbox.length) {
              const row = d.outbox[0];
              pulse(d, 'up');
              await wait(520);
              if (!d.online) return;
              const c = { seq: ++state.seq, from: d.id, scope: d.scope, title: row.title, delivered: [] };
              state.log.push(c);
              d.outbox.shift();
              row.seq = c.seq; d.cursor = c.seq;
              renderLog(c.seq); renderDevice(d);
              const targets = DEVICES.filter((o) => o !== d && o.online && o.scope === d.scope);
              for (const o of targets) pulse(o, 'down');
              if (targets.length) await wait(520);
              for (const o of targets) deliver(o, c);
              if (targets.length) renderLog();
              await wait(180);
            }
          }

          function write(d) {
            const pool = POOL[d.scope];
            const row = { title: pool[poolIdx[d.scope]++ % pool.length], seq: 0 };
            d.rows.unshift(row); d.outbox.push(row);
            renderDevice(d, row);
            if (d.online) enqueue(() => push(d));
          }

          function setOnline(d, online) {
            d.online = online;
            renderDevice(d);
            if (!online) return;
            enqueue(async () => {
              const missed = state.log.filter((c) => c.seq > d.cursor && c.scope === d.scope && c.from !== d.id);
              if (missed.length) {
                pulse(d, 'down');
                await wait(520);
                for (const c of missed) deliver(d, c);
                renderLog();
              }
              renderDevice(d);
              await push(d);
            });
          }

          // Autoplay until the visitor touches a control: a plain write, an offline
          // write, and the replay on reconnect.
          const SCRIPT = [
            () => write(DEVICES[0]),
            () => write(DEVICES[2]),
            () => setOnline(DEVICES[1], false),
            () => write(DEVICES[1]),
            () => write(DEVICES[0]),
            () => setOnline(DEVICES[1], true),
            () => write(DEVICES[1]),
          ];
          let step = 0;
          function stopAuto() {
            if (!auto) return;
            auto = false; clearInterval(autoTimer);
            modeEl.textContent = 'MANUAL';
            modeEl.className = 'text-dim';
          }
          document.getElementById('sim-reset').addEventListener('click', () => { stopAuto(); reset(); });
          reset();
          const seen = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting || !auto || autoTimer) return;
            if (reducedMotion) { stopAuto(); return; }
            autoTimer = setInterval(() => SCRIPT[step++ % SCRIPT.length](), 2200);
          }, { threshold: 0.3 });
          seen.observe(document.getElementById('sim'));
          cleanups.push(() => { seen.disconnect(); clearInterval(autoTimer); });
        })();

        return () => {
          alive = false;
          for (const id of timeouts) clearTimeout(id);
          for (const cleanup of cleanups) cleanup();
        };
      });
    </script>
  </body>
</html>
