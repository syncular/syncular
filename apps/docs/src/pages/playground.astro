---
import Docs from '../layouts/Docs.astro';
import { EXAMPLE_GROUPS, PLAYGROUND_EXAMPLES } from '../playground/examples';

const first = PLAYGROUND_EXAMPLES[0];
const groupTitle = (id: string) =>
  EXAMPLE_GROUPS.find((group) => group.id === id)?.title ?? id;
---

<Docs
  title="SYQL playground"
  active="playground"
  description="Edit SYQL against the Release board schema of the hosted demo, inspect the compiler-selected physical SQL plan, typed inputs, dependencies, and coverage, and run each statement on the demo's sample data."
  full={true}
>
  <div id="syql-playground" class="pg" data-state="loading" data-pane="editor" data-schema="open">
    <h1 class="sr-only">SYQL playground</h1>
    <div class="pg-bar">
      <button type="button" class="pg-pick" data-open-gallery aria-haspopup="dialog">
        <span class="pg-pick-group" data-example-group>{groupTitle(first?.group ?? '')}</span>
        <span class="pg-pick-title" data-example-title>{first?.title}</span>
        <svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
      </button>
      <div class="pg-step">
        <button type="button" data-step="-1" aria-label="Previous example">‹</button>
        <span data-example-position>1 / {PLAYGROUND_EXAMPLES.length}</span>
        <button type="button" data-step="1" aria-label="Next example">›</button>
      </div>
      <p class="pg-desc" data-example-description>{first?.description}</p>
      <div class="pg-actions">
        <button type="button" data-action="format">Format</button>
        <button type="button" data-action="reset" disabled>Reset</button>
        <button type="button" data-action="share">Share</button>
        <a href="/syql/">Guide</a>
      </div>
    </div>

    <div class="pg-panes" role="tablist" aria-label="Playground panes">
      <button type="button" role="tab" data-pane-tab="editor" aria-selected="true">Editor</button>
      <button type="button" role="tab" data-pane-tab="schema" aria-selected="false">Schema</button>
      <button type="button" role="tab" data-pane-tab="output" aria-selected="false">Output <span class="pg-count" data-problem-count hidden></span></button>
    </div>

    <div class="pg-work">
      <div class="pg-left">
        <section class="pg-frame pg-editor ticks" aria-label="SYQL source">
          <span class="tk-b"></span>
          <header class="pg-head">
            <span class="pg-kicker">source</span>
            <span class="pg-head-title">playground.syql</span>
            <span class="pg-edited" data-edited hidden>edited</span>
          </header>
          <div class="pg-host" data-source-host>
            <pre class="pg-fallback"><code>{first?.source}</code></pre>
          </div>
        </section>
        <div class="pg-split pg-split-y" role="separator" aria-orientation="horizontal" aria-label="Resize the schema pane" tabindex="0" data-split="schema"></div>
        <section class="pg-frame pg-schema" aria-label="Schema">
          <header class="pg-head">
            <span class="pg-kicker">schema</span>
            <span class="pg-head-title">Release board</span>
            <span class="pg-head-note">click inserts · shift-click inserts table.column</span>
            <button type="button" class="pg-collapse" data-action="toggle-schema" aria-expanded="true" aria-label="Collapse the schema pane">
              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
            </button>
          </header>
          <div class="pg-schema-body" data-schema-body></div>
        </section>
      </div>
      <div class="pg-split pg-split-x" role="separator" aria-orientation="vertical" aria-label="Resize the panes" tabindex="0" data-split="panes"></div>
      <section class="pg-frame pg-out ticks" aria-label="Compiler output" data-out="empty" data-active-tab="sql">
        <span class="tk-b"></span>
        <header class="pg-tabs">
          <div role="tablist" aria-label="Output">
            <button type="button" role="tab" data-tab="sql" aria-selected="true">SQL</button>
            <button type="button" role="tab" data-tab="run" aria-selected="false">Run</button>
            <button type="button" role="tab" data-tab="types" aria-selected="false">Types</button>
            <button type="button" role="tab" data-tab="reactivity" aria-selected="false">Reactivity</button>
            <button type="button" role="tab" data-tab="problems" aria-selected="false">Problems <span class="pg-count" data-problem-count hidden></span></button>
            <button type="button" role="tab" data-tab="json" aria-selected="false">JSON</button>
          </div>
          <label class="pg-query" data-query-picker hidden>
            <span>query</span>
            <select data-query></select>
          </label>
        </header>
        <div class="pg-stale" data-stale hidden>
          <span>Showing the last successful plan. The current source does not compile.</span>
          <button type="button" data-goto-tab="problems">Show problems</button>
        </div>
        <div class="pg-panel" data-panel="sql">
          <div class="pg-tools">
            <label><span>statement</span><select data-statement></select></label>
            <label><span>binds</span>
              <select data-representation>
                <option value="named">named</option>
                <option value="positional">positional</option>
              </select>
            </label>
            <span class="pg-badges"><span data-backend>—</span><span data-statement-count>—</span></span>
            <button type="button" data-action="copy" disabled>Copy</button>
          </div>
          <div class="pg-host" data-sql-host></div>
        </div>
        <div class="pg-panel pg-scroll" data-panel="run" hidden>
          <form class="pg-params" data-params></form>
          <div class="pg-run-bar">
            <button type="button" class="pg-primary" data-action="run">Run</button>
            <span data-run-meta>Runs the selected statement on the demo's sample data: 2 boards, 4 people, 24 cards.</span>
          </div>
          <div class="pg-results" data-results></div>
        </div>
        <div class="pg-panel pg-scroll" data-panel="types" hidden></div>
        <div class="pg-panel pg-scroll" data-panel="reactivity" hidden></div>
        <div class="pg-panel pg-scroll" data-panel="problems" hidden></div>
        <div class="pg-panel pg-scroll" data-panel="json" hidden><pre data-json></pre></div>
        <div class="pg-empty" data-empty>
          <p data-empty-text>Loading the editor and the SYQL compiler.</p>
        </div>
      </section>
    </div>

    <footer class="pg-foot">
      <span class="pg-keys">
        <span><kbd data-key="mod"></kbd><kbd>↵</kbd> run</span>
        <span><kbd data-key="shift"></kbd><kbd data-key="alt"></kbd><kbd>F</kbd> format</span>
        <span><kbd data-key="alt"></kbd><kbd>[</kbd> <kbd data-key="alt"></kbd><kbd>]</kbd> example</span>
      </span>
      <span class="pg-status" role="status" aria-live="polite" data-status>Loading the editor and the SYQL compiler.</span>
    </footer>

    <dialog class="pg-gallery" data-gallery aria-label="Examples">
      <header>
        <span class="pg-kicker">examples</span>
        <span>{PLAYGROUND_EXAMPLES.length} queries on the Release board model</span>
        <button type="button" data-close-gallery aria-label="Close">×</button>
      </header>
      <div class="pg-gallery-body">
        {
          EXAMPLE_GROUPS.map((group) => (
            <section>
              <h2>{group.title}</h2>
              {PLAYGROUND_EXAMPLES.filter((example) => example.group === group.id).map((example) => (
                <button type="button" data-example-id={example.id}>
                  <span class="t">{example.title}</span>
                  <span class="d">{example.description}</span>
                  {example.fails ? <span class="f">fails with {example.fails}</span> : null}
                </button>
              ))}
            </section>
          ))
        }
      </div>
    </dialog>

    <noscript>
      <p class="pg-noscript">
        The playground needs JavaScript for its editor and compiler. The
        <a href="/syql/">SYQL guide</a> works without it.
      </p>
    </noscript>
  </div>

  <script>
    // A failed module load would otherwise leave "Loading the editor" on
    // screen with the cause only in the console.
    import('../playground/client').catch((error: unknown) => {
      const root = document.querySelector<HTMLElement>('#syql-playground');
      if (!root) return;
      root.dataset.state = 'error';
      const status = root.querySelector('[data-status]');
      if (status) {
        status.textContent = `The playground failed to load: ${error instanceof Error ? error.message : String(error)}`;
      }
      throw error;
    });
  </script>
</Docs>

<style is:global>
  .pg {
    --pg-split: 48%;
    --pg-schema: 40%;
    --pg-red: #e0745a;
    --pg-cyan: #6fb3c0;
    --pg-sand: #e3d3a2;
    --pg-phos: #a9bf6e;
    --pg-raised: #12110f;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    color: var(--ink);
    background: var(--void);
  }
  .pg button { font: inherit; color: inherit; background: none; border: 0; border-radius: 0; }
  .pg button:disabled { cursor: not-allowed; opacity: 0.45; }
  .pg kbd {
    display: inline-block;
    min-width: 1.1rem;
    line-height: 1.35;
    margin-right: 0.15rem;
    padding: 0 0.25rem;
    border: 1px solid var(--line-strong);
    color: var(--dim);
    font: inherit;
    font-size: 10px;
    text-align: center;
  }
  .pg-kicker { color: var(--amber); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; }

  /* Toolbar */
  .pg-bar {
    flex: none;
    display: flex;
    align-items: stretch;
    min-width: 0;
    height: 2.75rem;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }
  .pg-pick {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    max-width: 26rem;
    padding: 0 0.9rem;
    border-right: 1px solid var(--line) !important;
    text-align: left;
  }
  .pg-pick:hover { background: var(--pg-raised) !important; }
  .pg-pick-group { flex: none; color: var(--faint); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; }
  .pg-pick-title { min-width: 0; overflow: hidden; font-size: 12.5px; text-overflow: ellipsis; white-space: nowrap; }
  .pg-pick svg { flex: none; color: var(--amber); }
  .pg-step { display: flex; align-items: stretch; border-right: 1px solid var(--line); }
  .pg-step button { width: 2rem; color: var(--dim) !important; font-size: 15px !important; }
  .pg-step button:hover { color: var(--amber) !important; background: var(--pg-raised) !important; }
  .pg-step span { align-self: center; min-width: 3.4rem; color: var(--faint); font-size: 10.5px; text-align: center; }
  .pg-desc {
    flex: 1;
    min-width: 0;
    align-self: center;
    margin: 0;
    padding: 0 0.9rem;
    overflow: hidden;
    color: var(--dim);
    font-family: var(--font-sans, 'IBM Plex Sans', sans-serif);
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pg-actions { display: flex; align-items: stretch; }
  .pg-actions > * {
    display: flex;
    align-items: center;
    padding: 0 0.85rem;
    border-left: 1px solid var(--line) !important;
    color: var(--dim) !important;
    font-size: 11px !important;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .pg-actions > *:hover:not(:disabled) { color: var(--ink) !important; background: var(--pg-raised) !important; }

  /* Mobile pane tabs */
  .pg-panes { display: none; }

  /* Work area */
  .pg-work {
    flex: 1;
    display: grid;
    grid-template-columns: max(32.5rem, var(--pg-split)) 0.6rem minmax(0, 1fr);
    min-height: 0;
    padding: 0.6rem 0.75rem 0;
  }
  .pg-left {
    display: grid;
    grid-template-rows: minmax(0, 1fr) 0.6rem minmax(0, var(--pg-schema));
    min-height: 0;
    min-width: 0;
  }
  .pg[data-schema='collapsed'] .pg-left { grid-template-rows: minmax(0, 1fr) 0.6rem auto; }
  .pg[data-schema='collapsed'] .pg-schema-body,
  .pg[data-schema='collapsed'] .pg-head-note { display: none; }
  .pg[data-schema='collapsed'] .pg-collapse svg { transform: rotate(180deg); }
  .pg-frame {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    border: 1px solid var(--line-strong);
    background: var(--panel);
  }
  .pg-head {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.7rem;
    height: 2.1rem;
    padding: 0 0 0 0.8rem;
    border-bottom: 1px solid var(--line);
    background: var(--void);
    font-size: 11.5px;
  }
  .pg-head-title { color: var(--dim); white-space: nowrap; }
  .pg-head-note { margin-left: auto; overflow: hidden; color: var(--faint); font-size: 10.5px; white-space: nowrap; text-overflow: ellipsis; }
  .pg-edited { color: var(--amber); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; }
  .pg-edited::before { content: ''; display: inline-block; width: 5px; height: 5px; margin-right: 0.4rem; background: var(--amber); vertical-align: 1px; }
  .pg-collapse { align-self: stretch; width: 2.2rem; border-left: 1px solid var(--line) !important; color: var(--dim) !important; }
  .pg-head-note + .pg-collapse { margin-left: 0; }
  .pg-collapse:hover { color: var(--amber) !important; }
  .pg-schema .pg-head-title + .pg-collapse { margin-left: auto; }
  .pg-host { position: relative; flex: 1; min-height: 0; overflow: hidden; }
  .pg-fallback { position: absolute; inset: 0; margin: 0; padding: 0.9rem 1rem; overflow: auto; color: var(--dim); font-size: 13px; line-height: 21px; }
  .pg-host .monaco-editor, .pg-host .overflow-guard { width: 100% !important; height: 100% !important; }
  .pg-usage { background: rgba(255, 176, 0, 0.22); outline: 1px solid rgba(255, 176, 0, 0.5); }

  /* Splitters */
  .pg-split { position: relative; touch-action: none; }
  .pg-split::after { content: ''; position: absolute; background: transparent; transition: background 0.15s; }
  .pg-split-x { cursor: col-resize; }
  .pg-split-x::after { top: 0; bottom: 0; left: calc(50% - 1px); width: 2px; }
  .pg-split-y { cursor: row-resize; }
  .pg-split-y::after { left: 0; right: 0; top: calc(50% - 1px); height: 2px; }
  .pg-split:hover::after, .pg-split:focus-visible::after, .pg-split[data-dragging]::after { background: var(--amber); }
  .pg-split:focus-visible { outline: none; }
  .pg[data-dragging] { cursor: inherit; user-select: none; }
  .pg[data-dragging] .pg-host { pointer-events: none; }

  /* Schema */
  .pg-schema-body {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    align-content: start;
    gap: 0.6rem;
    min-height: 0;
    padding: 0.6rem;
    overflow: auto;
  }
  .pg-table { border: 1px solid var(--line); background: var(--void); font-size: 11.5px; }
  .pg-table-head { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.4rem 0.55rem; border-bottom: 1px solid var(--line); }
  .pg-table-head button { color: var(--ink) !important; font-size: 12.5px !important; font-weight: 600; }
  .pg-table-head span { margin-left: auto; color: var(--faint); font-size: 10px; }
  .pg-table ul { margin: 0; padding: 0.25rem 0; list-style: none; }
  .pg-table li { display: flex; align-items: baseline; gap: 0.45rem; padding: 0.1rem 0.55rem; }
  .pg-table li:hover { background: var(--pg-raised); }
  .pg-table li button { color: var(--dim) !important; text-align: left; }
  .pg-table button:hover, .pg-table button:focus-visible { color: var(--amber) !important; }
  .pg-table [data-used] { color: var(--ink) !important; }
  .pg-table [data-used]::after { content: '•'; margin-left: 0.3rem; color: var(--amber); }
  .pg-type { margin-left: auto; color: var(--faint); font-size: 10.5px; white-space: nowrap; }
  .pg-tag { flex: none; padding: 0 0.25rem; border: 1px solid currentColor; font-size: 9px; letter-spacing: 0.08em; }
  .pg-tag.pk { color: var(--amber); }
  .pg-tag.scope { color: var(--pg-cyan); }
  .pg-tag.ref { color: var(--pg-sand); border-color: transparent; padding: 0; letter-spacing: 0; }
  .pg-table-foot { padding: 0.35rem 0.55rem; border-top: 1px solid var(--line); color: var(--faint); font-size: 10.5px; }

  /* Output */
  .pg-out { position: relative; }
  .pg-tabs {
    display: flex;
    flex: none;
    align-items: stretch;
    justify-content: space-between;
    height: 2.1rem;
    border-bottom: 1px solid var(--line);
    background: var(--void);
  }
  .pg-tabs [role='tablist'] { display: flex; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .pg-tabs [role='tab'], .pg-panes [role='tab'] {
    position: relative;
    flex: none;
    padding: 0 0.8rem;
    border-right: 1px solid var(--line) !important;
    color: var(--dim) !important;
    font-size: 11px !important;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pg-tabs [role='tab']:hover, .pg-panes [role='tab']:hover { color: var(--ink) !important; }
  .pg-tabs [aria-selected='true'], .pg-panes [aria-selected='true'] { color: var(--ink) !important; background: var(--panel) !important; }
  .pg-tabs [aria-selected='true']::after, .pg-panes [aria-selected='true']::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--amber);
  }
  .pg-count { margin-left: 0.3rem; padding: 0 0.3rem; background: var(--pg-red); color: #000; font-size: 10px; letter-spacing: 0; }
  .pg-query { display: flex; align-items: center; gap: 0.5rem; padding: 0 0.6rem; border-left: 1px solid var(--line); font-size: 11px; }
  .pg-query span, .pg-tools label span { color: var(--faint); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; }
  .pg select, .pg input[type='text'], .pg input[type='number'] {
    min-width: 0;
    height: 1.7rem;
    padding: 0 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: var(--void);
    color: var(--ink);
    font: inherit;
    font-size: 11.5px;
  }
  .pg select:focus-visible, .pg input:focus-visible { outline: 1px solid var(--amber); outline-offset: 0; }
  .pg-panel { display: flex; flex: 1; flex-direction: column; min-height: 0; }
  .pg-panel[hidden] { display: none; }
  .pg-scroll { display: block; overflow: auto; padding: 0.9rem 1rem 1.2rem; }
  .pg-tools {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    padding: 0.45rem 0.8rem;
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
  }
  .pg-tools label { display: flex; align-items: center; gap: 0.45rem; min-width: 0; }
  .pg-tools [data-statement] { max-width: 22rem; }
  .pg-badges { display: flex; gap: 0.35rem; margin-left: auto; }
  .pg-badges span { padding: 0.1rem 0.4rem; border: 1px solid var(--line); color: var(--dim); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  .pg-tools button, .pg-primary, .pg-stale button, .pg-problem button, .pg-empty button {
    height: 1.7rem;
    padding: 0 0.7rem;
    border: 1px solid var(--line-strong) !important;
    color: var(--dim) !important;
    font-size: 10.5px !important;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pg-tools button:hover:not(:disabled), .pg-stale button:hover, .pg-problem button:hover, .pg-empty button:hover { border-color: var(--amber) !important; color: var(--amber) !important; }
  .pg-primary { border-color: var(--amber) !important; background: var(--amber) !important; color: #000 !important; font-weight: 600; }
  .pg-primary:hover { background: #ffc233 !important; }
  .pg-stale {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    padding: 0.4rem 0.8rem;
    border-bottom: 1px solid rgba(224, 116, 90, 0.5);
    background: rgba(224, 116, 90, 0.08);
    color: #f0a08c;
    font-size: 11.5px;
  }
  .pg-stale[hidden] { display: none; }
  .pg-empty { display: none; flex: 1; align-items: center; justify-content: center; padding: 2rem; text-align: center; }
  .pg-out[data-out='empty'] .pg-empty { display: flex; }
  .pg-out[data-out='empty'] .pg-panel:not([data-panel='problems']) { display: none; }
  .pg-out[data-out='empty'][data-active-tab='problems'] .pg-empty { display: none; }
  .pg-empty p { max-width: 28rem; margin: 0 auto 0.9rem; color: var(--dim); font-family: var(--font-sans, sans-serif); font-size: 13.5px; line-height: 1.6; }
  .pg[data-state='error'] .pg-empty p { color: #f0a08c; }

  /* Output sections */
  .pg-section + .pg-section { margin-top: 1.4rem; }
  .pg-section h3 { margin: 0 0 0.5rem; color: var(--amber); font-size: 10.5px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; }
  .pg-section p { margin: 0 0 0.6rem; color: var(--dim); font-family: var(--font-sans, sans-serif); font-size: 13px; line-height: 1.6; }
  .pg-section code, .pg-problem code { color: var(--ink); font-size: 0.92em; }
  .pg-grid { width: 100%; border-collapse: collapse; font-size: 11.5px; }
  .pg-grid th { padding: 0.35rem 0.6rem; border-bottom: 1px solid var(--line-strong); color: var(--faint); font-size: 10px; font-weight: 500; letter-spacing: 0.1em; text-align: left; text-transform: uppercase; white-space: nowrap; }
  .pg-grid td { padding: 0.32rem 0.6rem; border-bottom: 1px solid var(--line); color: var(--ink); vertical-align: top; }
  .pg-grid td.num { color: var(--pg-cyan); text-align: right; font-variant-numeric: tabular-nums; }
  .pg-grid td.null { color: var(--faint); font-style: italic; }
  .pg-grid td.dim { color: var(--dim); }
  .pg-grid tbody tr:hover td { background: var(--pg-raised); }
  .pg-ok { color: var(--pg-phos); }
  .pg-warn { color: var(--amber); }
  [data-json] { margin: 0; color: var(--dim); font-size: 11.5px; line-height: 1.55; white-space: pre-wrap; }

  /* Problems */
