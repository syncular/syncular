---
// Every markdown file in src/content/ becomes /<filename>/. The page's first
// `# Heading` is the <title>; the heading itself stays in the rendered body.
// The page type and sidebar position come from src/nav.ts.
import type { MarkdownInstance } from 'astro';
import Docs from '../layouts/Docs.astro';
import { markdownDescription } from '../seo';

export async function getStaticPaths() {
  const mods = import.meta.glob<MarkdownInstance<Record<string, never>>>(
    '../content/*.md',
    { eager: true },
  );
  return Object.entries(mods).map(([path, mod]) => ({
    params: { slug: path.split('/').pop()?.replace(/\.md$/, '') ?? '' },
    props: { mod },
  }));
}

interface Props {
  mod: MarkdownInstance<Record<string, never>>;
}
const { mod } = Astro.props;
const { slug } = Astro.params;
const headings = mod.getHeadings();
const title = headings.find((h) => h.depth === 1)?.text ?? 'syncular';
const description = markdownDescription(mod.rawContent());
const Content = mod.Content;
---

<Docs
  title={title}
  active={slug ?? ''}
  description={description}
  headings={headings}
  sourcePath={`apps/docs/src/content/${slug}.md`}
>
  <Content />
</Docs>
