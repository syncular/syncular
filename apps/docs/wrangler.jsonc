{
  // The docs site is served as a Workers static-assets deployment (not Pages)
  // at the apex syncular.dev via a zone route over the apex's existing
  // proxied DNS record — a plain worker route rather than a custom domain, so
  // deploys never touch DNS. `dist/` is produced by `bun run build` (astro
  // build + agent assets); the site serves at the domain root, which is what
  // its root-absolute links assume.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syncular-docs",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "syncular_docs_engagement"
    }
  ],
  "routes": [{ "pattern": "syncular.dev/*", "zone_name": "syncular.dev" }]
}
